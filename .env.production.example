NODE_ENV=production
HOST=127.0.0.1
PORT=4317
DB_PATH=/var/lib/wordflow/wordflow.db
LEARNING_TIME_ZONE=Asia/Singapore
TRUST_PROXY=true
COOKIE_SECURE=false
COOKIE_PATH=/wordflow
SESSION_TTL_DAYS=90
WORDFLOW_USERNAME=replace-with-your-username
WORDFLOW_PASSWORD=replace-with-your-password
SESSION_SECRET=replace-with-a-long-random-secret
